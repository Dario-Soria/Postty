FROM node:20-bookworm-slim AS build

WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend ./

# The package scripts use dotenv to load ../.env. Provide an empty file so build works in Docker.
RUN mkdir -p /app && touch /app/.env

RUN npm run build

FROM node:20-bookworm-slim AS runtime

WORKDIR /app/frontend
ENV NODE_ENV=production
ENV PORT=3000

COPY --from=build /app/frontend/package.json /app/frontend/package-lock.json ./
COPY --from=build /app/frontend/node_modules ./node_modules
COPY --from=build /app/frontend/.next ./.next
COPY --from=build /app/frontend/public ./public

# Ensure dotenv target exists for the start script
RUN mkdir -p /app && touch /app/.env

EXPOSE 3000

CMD ["npm", "run", "start"]
